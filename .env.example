# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend Email API Key for sending and receiving webhook parsing
RESEND_API_KEY="re_123456789"

# RESEND_FROM: Verified sender domain for GoldMail
RESEND_FROM="GoldMailer <noreply@goldmailer.xyz>"

# SMTP Configuration (Exclusively using goldmailer.xyz primary domain)
SMTP_HOST="smtp.goldmailer.xyz"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="postmaster@goldmailer.xyz"
SMTP_PASS=""
SMTP_FROM="GoldMailer <noreply@goldmailer.xyz>"

# Supabase database config (optional if connecting custom Supabase project)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY=""

# Telnyx Configuration (SMS, Voice, Inbound & Virtual Numbers)
TELNYX_API_KEY=""
TELNYX_PHONE_NUMBER="+14236662513"
TELNYX_MESSAGING_PROFILE_ID="4001a139-34ea-4725-a3be-890f641b9137"
TELNYX_VOICE_APP_ID="3070367984242394362"
TELNYX_PUBLIC_KEY=""

# JWT Session Secret
JWT_SECRET="goldmailer_super_secret_jwt_key_2026_xyz"

# NOWPayments Configuration (Payment gateway for phone numbers)
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
IPN_SECRET=""

# Firebase Configuration (Persistent Firestore Database & Auth)
VITE_FIREBASE_API_KEY="AIzaSyDRWzRgWbAjVI-mYXGnLDc9Ea9ST2IGyiw"
VITE_FIREBASE_AUTH_DOMAIN="myassetpay-24c2d.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="myassetpay-24c2d"
VITE_FIREBASE_STORAGE_BUCKET="myassetpay-24c2d.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="914618622784"
VITE_FIREBASE_APP_ID="1:914618622784:web:868b35828e4eb2419f50a5"
VITE_FIREBASE_MEASUREMENT_ID="G-4YPZR6HX9Z"

# Vercel Deployment Checklist:
# In Vercel Project Settings -> Environment Variables, configure:
# - APP_URL (e.g. https://goldmailer.xyz or https://your-app.vercel.app)
# - VITE_FIREBASE_* variables (for Firebase Auth & Firestore DB persistence)
# - VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY (for Supabase persistence)
# - SUPABASE_SERVICE_ROLE_KEY (optional, for admin access)
# - JWT_SECRET (secure random string)
# - TELNYX_* variables (for phone, SMS, voice)
# - RESEND_API_KEY, RESEND_FROM, SMTP_* (for email deliverability)
# - NOWPAYMENTS_* (for crypto billing)

