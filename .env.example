# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend Email API Key for sending and receiving webhook parsing
RESEND_API_KEY="re_123456789"

# RESEND_FROM: Verified sender domain for GoldMail
RESEND_FROM="GoldMailer <noreply@goldmailer.xyz>"

# SMTP Configuration (Exclusively using goldmailer.xyz primary domain)
SMTP_HOST="smtp.goldmailer.xyz"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="postmaster@goldmailer.xyz"
SMTP_PASS=""
SMTP_FROM="GoldMailer <noreply@goldmailer.xyz>"

# Supabase database config (optional if connecting custom Supabase project)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY=""

# SignalWire Configuration
SIGNALWIRE_PROJECT_ID="c4c9559f-11f4-4125-9c81-ae5aba970a12"
SIGNALWIRE_API_TOKEN="swapi_lfh1VsXvtgRI3gzWtghdDVba8f7An9qf36zg"
SIGNALWIRE_SPACE_URL="tasknest.signalwire.com"
SIGNALWIRE_PHONE_NUMBER="+12056076793"
SIGNALWIRE_SIGNING_KEY="PSK_zd8NAKiZku142b86cW8CDkDU"
SIGNALWIRE_WEBHOOK_URL="https://goldmailer.xyz/api/signalwire/inbound"

# JWT Session Secret
JWT_SECRET="goldmailer_super_secret_jwt_key_2026_xyz"

# NOWPayments Configuration (Payment gateway for phone numbers)
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
IPN_SECRET=""

# Vercel Deployment Checklist:
# In Vercel Project Settings -> Environment Variables, configure:
# - APP_URL (e.g. https://goldmailer.xyz or https://your-app.vercel.app)
# - VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY (for Supabase persistence)
# - SUPABASE_SERVICE_ROLE_KEY (optional, for admin access)
# - JWT_SECRET (secure random string)
# - SIGNALWIRE_* variables (for phone, SMS, voice)
# - RESEND_API_KEY, RESEND_FROM, SMTP_* (for email deliverability)
# - NOWPAYMENTS_* (for crypto billing)

